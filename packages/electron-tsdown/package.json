{
  "name": "electron-tsdown",
  "version": "12.0.3",
  "description": "Use tsdown and vite with Electron for blazing fast compilation",
  "keywords": [
    "cli",
    "electron",
    "hmr",
    "hot reload",
    "tsdown",
    "vite"
  ],
  "license": "MIT",
  "author": "Kiyozz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiyozz/electron-tsdown.git",
    "directory": "packages/electron-tsdown"
  },
  "bin": {
    "electron-tsdown": "./dist/run.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepublishOnly": "tsc -b && tsdown",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@adonisjs/fold": "^11.1.0",
    "cac": "^7.1.0",
    "debounce-fn": "^6.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tinyexec": "^1.3.1",
    "unconfig": "^7.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "tsdown": "^0.22.0",
    "vite": "8.x"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
